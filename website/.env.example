# The site's public URL. Google sends sign-ins back to $NEXT_PUBLIC_SITE_URL/api/auth/google/callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The progress database, the same one the MCP server uses. The dashboard only reads from it.
DATABASE_URL=postgres://dsa:dsa@localhost:5432/dsa_progress
# Google OAuth client ("Web application") with the redirect URI above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. At least 32 characters: openssl rand -base64 32
SESSION_SECRET=
